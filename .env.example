# Modo de generación: none (sin proveedor), openai.
CONTENT_GEN_AI_PROVIDER=none

# Solo es requerida cuando CONTENT_GEN_AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-sol
# Guiones de video: si se omiten, usan OPENAI_TEXT_MODEL.
OPENAI_SCRIPT_MODEL=
OPENAI_VOICEOVER_SCRIPT_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2

# Opcionales: se activarán cuando las fases de media correspondientes estén listas.
# Unsplash: acceso actual por Access Key; App ID y Secret quedan listos para OAuth/administración.
UNSPLASH_APP_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_MODEL=eleven_multilingual_v2

# Métricas externas (Search Console + GA4). Se leen con una service account de Google Cloud:
# crea la cuenta, descarga su JSON y dale acceso de lectura en cada propiedad.
# Usa GOOGLE_SERVICE_ACCOUNT_KEY_FILE (ruta al JSON, recomendado) o pega el JSON en una línea.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Search Console: 'sc-domain:ejemplo.com' (propiedad de dominio) o 'https://ejemplo.com/' (prefijo de URL).
SEARCH_CONSOLE_SITE_URL=
# GA4: identificador numérico de la propiedad (Administrar > Detalles de la propiedad), no el G-XXXX.
GA4_PROPERTY_ID=
# Días que se reprocesan en cada sincronización; el solapamiento corrige datos tardíos.
ANALYTICS_SYNC_DAYS=28

# Redacción de artículos con IA: usa OPENAI_TEXT_MODEL y requiere CONTENT_GEN_AI_PROVIDER=openai.
# Con búsqueda web activada son dos llamadas (investigar y redactar): la API no admite
# `web_search` junto al modo JSON.

# Blog: raíz del repositorio del sitio (el que tiene content/blog y public/blog).
# Al exportar, content-gen escribe el .md y la portada ahí; el commit y el push los haces tú.
BLOG_SITE_PATH=

# Persistencia local. No incluir secretos reales en este archivo.
DATABASE_URL=file:./storage/content-gen.sqlite
MEDIA_STORAGE_PATH=./storage/media
MAX_ACTIVE_RENDER_JOBS=2
# Al encolar un render, la app arranca el worker sola. Ponlo en 0 para procesar la cola a mano
# con `npm run worker:once` (lo usan las pruebas para que el render sea determinista).
RENDER_WORKER_AUTOSTART=1
