{
  "name": "content-gen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@content-gen/studio",
    "start": "npm run start --workspace=@content-gen/studio",
    "test": "node scripts/run-test-suite.mjs local",
    "test:integration": "node scripts/run-test-suite.mjs integration",
    "verify": "node scripts/verify.mjs",
    "test:worker": "npm run test:job --workspace=@content-gen/render-worker",
    "test:worker-progress": "node apps/render-worker/src/worker.test.mjs",
    "worker:once": "node --env-file-if-exists=.env.local --env-file-if-exists=.env apps/render-worker/src/worker.mjs --once",
    "test:domain": "node --experimental-strip-types packages/domain/src/schemas.test.ts",
    "test:carousel": "node --experimental-strip-types packages/domain/src/carousel.test.ts",
    "test:ad": "node --experimental-strip-types packages/domain/src/ad.test.ts",
    "test:video": "node --experimental-strip-types packages/domain/src/video.test.ts",
    "test:content-assets": "node --experimental-strip-types apps/studio/src/lib/content-assets.test.ts",
    "test:asset-storage": "node --experimental-strip-types apps/studio/src/lib/asset-storage.test.ts",
    "test:legacy-import": "node --experimental-strip-types scripts/legacy-import.test.mjs",
    "test:http-boundaries": "node --experimental-strip-types scripts/http-boundaries-integration.mjs",
    "test:e2e": "node scripts/main-flows-e2e.mjs",
    "test:a11y": "node scripts/accessibility-static.mjs",
    "test:performance": "node scripts/performance-baseline.mjs",
    "test:path-safety": "node --experimental-strip-types scripts/path-safety.test.mjs",
    "test:video-metadata": "node --experimental-strip-types packages/video-engine/src/video-metadata.test.ts",
    "test:migrate-videos": "node --experimental-strip-types scripts/migrate-video-documents.test.mjs",
    "test:repair-encoding": "node scripts/repair-text-encoding.test.mjs",
    "test:render-limits": "node --experimental-strip-types apps/studio/src/lib/render-limits.test.ts",
    "test:render-worker": "node --experimental-strip-types apps/studio/src/lib/render-worker.test.ts",
    "test:ad-generation": "node --experimental-strip-types apps/studio/src/lib/ad-generation.test.ts",
    "test:openai": "node --experimental-strip-types apps/studio/src/lib/openai.test.ts",
    "test:video-generation": "node --experimental-strip-types apps/studio/src/lib/video-generation.test.ts",
    "test:generation-runs": "node --experimental-strip-types apps/studio/src/lib/generation-runs.test.ts",
    "test:video-scene-images": "node --experimental-strip-types apps/studio/src/lib/video-scene-images.test.ts",
    "test:voiceover-script": "node --experimental-strip-types apps/studio/src/lib/voiceover-script.test.ts",
    "test:elevenlabs": "node --experimental-strip-types apps/studio/src/lib/elevenlabs.test.ts",
    "test:video-scene-audio": "node --experimental-strip-types apps/studio/src/lib/video-scene-audio.test.ts",
    "test:video-caption": "node --experimental-strip-types apps/studio/src/lib/video-caption.test.ts",
    "test:campaign-progress": "node --experimental-strip-types apps/studio/src/lib/campaign-progress.test.ts",
    "test:campaign-export": "node --experimental-strip-types apps/studio/src/lib/campaign-export.test.ts",
    "test:ad-export": "node --experimental-strip-types apps/studio/src/lib/ad-export.test.ts",
    "test:persistence": "node scripts/persistence-integration.mjs",
    "test:carousel-generation": "node --experimental-strip-types apps/studio/src/lib/carousel-generation.test.ts",
    "test:carousel-images": "node --experimental-strip-types apps/studio/src/lib/carousel-images.test.ts",
    "test:carousel-export": "node --experimental-strip-types apps/studio/src/lib/carousel-export.test.ts",
    "test:carousel-slides": "node --experimental-strip-types apps/studio/src/lib/carousel-slides.test.ts",
    "test:carousel-remix": "node --experimental-strip-types apps/studio/src/lib/carousel-remix.test.ts",
    "db:init": "node scripts/init-db.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "check:integrity": "node scripts/check-integrity.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "legacy:scan-video": "node --experimental-strip-types scripts/legacy-import.mjs scan-video",
    "legacy:import-carousel": "node --experimental-strip-types scripts/legacy-import.mjs import-carousel",
    "legacy:import-video": "node --experimental-strip-types scripts/legacy-import.mjs import-video",
    "legacy:import-manual": "node --experimental-strip-types scripts/legacy-import.mjs import-manual",
    "legacy:render-manual": "node --experimental-strip-types scripts/legacy-import.mjs render-manual",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:env": "node scripts/check-env.mjs",
    "migrate:videos": "node --experimental-strip-types --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate-video-documents.mjs",
    "repair:encoding": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/repair-text-encoding.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "typescript-eslint": "^8.22.0"
  }
}
